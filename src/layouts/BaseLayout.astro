---
import '../styles/global.css';
import Header from '../components/Header.astro';
import NavInferior from '../components/NavInferior.astro';
import Footer from '../components/Footer.astro';
import { sitio } from '../data/site';

interface Props {
  titulo: string;
  descripcion: string;
  imagenOG?: string;
}

const { titulo, descripcion, imagenOG = '/og-image.jpg' } = Astro.props;
/** Canonical con barra final en rutas de directorio (/menu/) como sirve Netlify. */
const rutaCanonical =
  Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const urlCanonical = new URL(rutaCanonical, sitio.url).href;
/** El hero solo existe en la home: no se precarga en /menu (desperdicio). */
const esInicio = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlCanonical} />

    <!-- Favicon y app icons derivados del logotipo oficial -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#42501F" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={sitio.nombreCompleto} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonical} />
    <meta property="og:image" content={new URL(imagenOG, sitio.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={new URL(imagenOG, sitio.url).href} />

    <!-- Tipografía: serif editorial para títulos, sans legible para lectura.
         Auto-alojada en /fonts. El preload de la serif del titular acelera el
         FCP: el H1 pinta con la fuente oficial en vez de esperar su descubrimiento. -->
    {
      esInicio && (
        <link
          rel="preload"
          as="image"
          href="/img/hero-patio-768.webp"
          imagesrcset="/img/hero-patio-768.webp 768w, /img/hero-patio-1280.webp 1280w, /img/hero-patio.webp 1920w"
          imagesizes="100vw"
          fetchpriority="high"
        />
      )
    }
    <link rel="preload" as="font" type="font/woff2" href="/fonts/cormorant-garamond-500-normal-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/cormorant-garamond-400-italic-latin.woff2" crossorigin />

    <!-- View Transitions: el ClientRouter se integra en la Fase 4 junto con
         la vista /menu (es cuando aporta transiciones entre páginas). Hoy la
         landing es de una sola página y el router solo añadía costo de
         bloqueo (TBT). Las animaciones del overlay son CSS y respetan
         prefers-reduced-motion. -->
  </head>
  <body class="antialiased pb-[calc(4rem_+_env(safe-area-inset-bottom))] md:pb-0">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-marfil focus:px-4 focus:py-2 focus:text-verde"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <NavInferior />
  </body>
</html>
