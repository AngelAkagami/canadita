---
import '../styles/global.css';
import Header from '../components/Header.astro';
import NavInferior from '../components/NavInferior.astro';
import Footer from '../components/Footer.astro';
import { sitio } from '../data/site';

interface Props {
  titulo: string;
  descripcion: string;
  imagenOG?: string;
}

const { titulo, descripcion, imagenOG = '/og-image.jpg' } = Astro.props;
/** Canonical con barra final en rutas de directorio (/menu/) como sirve Netlify. */
const rutaCanonical =
  Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const urlCanonical = new URL(rutaCanonical, sitio.url).href;
/** El hero solo existe en la home: no se precarga en /menu (desperdicio). */
const esInicio = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlCanonical} />

    <!-- Favicon y app icons derivados del logotipo oficial -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#42501F" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={sitio.nombreCompleto} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonical} />
    <meta property="og:image" content={new URL(imagenOG, sitio.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={new URL(imagenOG, sitio.url).href} />

    <!-- Tipografía: serif editorial para títulos, sans legible para lectura.
         Auto-alojada en /fonts. Sin preload de las fuentes: en Lighthouse
         móvil competían por ancho de banda con la imagen del hero (LCP) y
         font-display:swap las pinta con la de reserva sin bloquear. -->
    {
      esInicio && (
        <link
          rel="preload"
          as="image"
          href="/img/hero-patio-768.webp"
          imagesrcset="/img/hero-patio-768.webp 768w, /img/hero-patio-1280.webp 1280w, /img/hero-patio.webp 1920w"
          imagesizes="100vw"
          fetchpriority="high"
        />
      )
    }

    <!-- View Transitions cross-document (Fase 5): el opt-in vive en
         global.css (@view-transition { navigation: auto }) y se aplica a
         / y /menu/ con fundidos de 200–350 ms. Sin JavaScript: en
         navegadores sin soporte la navegación es la normal. Las
         animaciones del overlay son CSS y respetan prefers-reduced-motion. -->
  </head>
  <body class="antialiased pb-[calc(4rem_+_env(safe-area-inset-bottom))] md:pb-0">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-marfil focus:px-4 focus:py-2 focus:text-verde"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <NavInferior />
  </body>
</html>
