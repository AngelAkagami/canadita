---
/**
 * Barra superior de tablet (>=768 px) y escritorio. En móvil la navegación
 * vive en NavInferior.astro (barra inferior fija + overlay + FAB).
 * En tablet se muestran los destinos esenciales; en escritorio, todos.
 */
import { navegacion, contacto, enlaceWhatsApp, ancla } from '../data/site';

const whatsappReserva = enlaceWhatsApp(contacto.whatsapp.mensajeReserva);
const ruta = Astro.url.pathname;
---

<header class="sticky top-0 z-50 hidden border-b border-marfil/15 bg-verde/95 backdrop-blur-sm md:block">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 md:h-20 md:py-0 lg:px-8">
    <a href={ancla('#inicio', ruta)} class="flex shrink-0 items-center" aria-label="La Cañadita — ir al inicio">
      <img
        src="/logo-claro-160.png"
        srcset="/logo-claro-160.png 160w, /logo-claro-240.png 240w, /logo-claro-360.png 360w, /logo-claro.png 872w"
        sizes="120px"
        alt="La Cañadita Restaurant"
        width={872}
        height={948}
        class="h-12 w-auto md:h-14"
      />
    </a>

    <nav aria-label="Navegación principal" class="hidden items-center gap-6 md:flex lg:gap-7">
      {
        navegacion.map((item) => (
          <a
            href={ancla(item.href, ruta)}
            aria-current={item.href === ruta ? 'page' : undefined}
            class:list={[
              'text-[0.8rem] font-medium uppercase tracking-[0.14em] text-marfil/85 transition-colors hover:text-marfil',
              item.esencial ? 'hidden md:inline' : 'hidden lg:inline',
            ]}
          >
            {item.etiqueta}
          </a>
        ))
      }
    </nav>

    <a
      href={whatsappReserva}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex shrink-0 items-center gap-2 bg-marfil px-5 py-2.5 text-[0.8rem] font-semibold uppercase tracking-[0.12em] text-verde transition-colors hover:bg-beige"
    >
      <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path d="M7 3v3M17 3v3M4 9h16M5 6h14a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1z"></path>
      </svg>
      Reservar mesa
    </a>
  </div>
</header>
