---
import { sitio, contacto, navegacion, horarios, enlaceWhatsApp } from '../data/site';

const whatsappReserva = enlaceWhatsApp(contacto.whatsapp.mensajeReserva);
const anio = new Date().getFullYear();
const { direccion, telefono, whatsapp, redes } = contacto;
---

<footer class="bg-verde-oscuro text-marfil/85">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-20 lg:px-8">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <img
          src="/logo-claro-360.png"
          srcset="/logo-claro-360.png 360w, /logo-claro.png 872w"
          sizes="140px"
          alt="La Cañadita Restaurant"
          width={872}
          height={948}
          loading="lazy"
          class="h-24 w-auto"
        />
        <p class="mt-5 max-w-xs text-sm leading-relaxed">{sitio.tagline}.</p>
      </div>

      <nav aria-label="Navegación del pie de página">
        <h2 class="antetitulo mb-4 text-beige">Navegación</h2>
        <ul class="space-y-2.5 text-sm">
          {
            navegacion.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-marfil">
                  {item.etiqueta}
                </a>
              </li>
            ))
          }
          <li>
            <a href="#brunch" class="transition-colors hover:text-marfil">Brunch dominical</a>
          </li>
        </ul>
      </nav>

      <div>
        <h2 class="antetitulo mb-4 text-beige">Contacto</h2>
        <ul class="space-y-2.5 text-sm not-italic">
          <li>
            <address class="not-italic">
              {direccion.linea1}<br />{direccion.linea2}<br />{direccion.ciudad}, {direccion.estado}
            </address>
          </li>
          <li>
            <a href={telefono.href} class="transition-colors hover:text-marfil">{telefono.visible}</a>
          </li>
          <li>
            <a href={whatsappReserva} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-marfil">
              WhatsApp {whatsapp.visible}
            </a>
          </li>
        </ul>

        <div class="mt-5 flex items-center gap-3">
          <a
            href={redes.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="La Cañadita en Facebook"
            class="flex h-10 w-10 items-center justify-center border border-marfil/30 transition-colors hover:bg-marfil hover:text-verde-oscuro"
          >
            <svg aria-hidden="true" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.57v1.88h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94z"></path>
            </svg>
          </a>
          <a
            href={redes.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="La Cañadita en Instagram"
            class="flex h-10 w-10 items-center justify-center border border-marfil/30 transition-colors hover:bg-marfil hover:text-verde-oscuro"
          >
            <svg aria-hidden="true" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"></circle>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h2 class="antetitulo mb-4 text-beige">Menú</h2>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="#menu" class="transition-colors hover:text-marfil">Sugerencias del chef</a>
          </li>
          <li>
            <a href={sitio.web} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-marfil">
              lacanadita.com
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-3 border-t border-marfil/15 pt-7 text-xs sm:flex-row">
      <p>© {anio} {sitio.nombreCompleto}. Cuernavaca, Morelos, México.</p>
      <p>{horarios.general}</p>
    </div>
  </div>
</footer>
