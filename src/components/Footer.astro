---
/**
 * Pie de página. En móvil va compacto: enlaces en dos columnas, contacto en
 * dos renglones y redes como iconos, para llegar pronto al nombre.
 */
import Icono from './Icono.astro';
import { sitio, contacto, navegacion, enlaceWhatsApp, ancla } from '../data/site';
import { resumenHorariosCorto } from '../data/horarios';

const ruta = Astro.url.pathname;
const whatsappReserva = enlaceWhatsApp(contacto.whatsapp.mensajeReserva);
const anio = new Date().getFullYear();
const { direccion, telefono, redes } = contacto;
const redesLista = [
  { nombre: 'Instagram', href: redes.instagram, icono: 'instagram' },
  { nombre: 'Facebook', href: redes.facebook, icono: 'facebook' },
  { nombre: 'TikTok', href: redes.tiktok, icono: 'tiktok' },
] as const;
---

<footer class="overflow-hidden border-t border-azul/15 pt-14 text-azul md:pt-24">
  <div class="mx-auto max-w-[1440px] px-5 md:px-6 lg:px-10">
    <div class="grid gap-9 text-sm md:grid-cols-12 md:gap-12">
      <div class="md:col-span-4">
        <p class="max-w-[28ch] font-display text-2xl leading-snug text-azul">{sitio.tagline}.</p>
      </div>
      <nav aria-label="Navegación del pie de página" class="md:col-span-3 md:col-start-5">
        <ul class="grid grid-cols-2 gap-x-6 gap-y-1 md:grid-cols-1 md:gap-y-2.5">
          {navegacion.map((item) => (
            <li><a href={ancla(item.href, ruta)} class="pie-enlace">{item.etiqueta}</a></li>
          ))}
          <li><a href={ancla('#horarios', ruta)} class="pie-enlace">Horarios</a></li>
        </ul>
      </nav>
      <div class="text-azul/65 md:col-span-3">
        <address class="not-italic">{direccion.linea1}, {direccion.linea2}<br class="hidden md:inline" /><span class="md:hidden"> · </span>{direccion.ciudad}, {direccion.estado}</address>
        <p class="mt-2.5 flex flex-wrap items-center gap-x-2">
          <a href={telefono.href} class="pie-enlace font-semibold text-azul">{telefono.visible}</a>
          <span aria-hidden="true">·</span>
          <a href={whatsappReserva} target="_blank" rel="noopener noreferrer" class="pie-enlace">WhatsApp</a>
        </p>
      </div>
      <ul class="flex gap-3 md:col-span-2 md:justify-end" aria-label="Redes sociales">
        {redesLista.map((r) => (
          <li>
            <a href={r.href} target="_blank" rel="noopener noreferrer" class="red" aria-label={`${r.nombre} de La Cañadita`}>
              <Icono nombre={r.icono} class="h-5 w-5" />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <p class="mt-12 select-none whitespace-nowrap font-display text-[17.5vw] leading-[0.8] tracking-[-0.045em] texto-oro md:mt-28 xl:text-[15.2rem]" aria-hidden="true">
      La Cañadita
    </p>

    <div class="flex flex-col justify-between gap-2 border-t border-azul/15 py-6 text-xs text-azul/50 sm:flex-row">
      <p>© {anio} {sitio.nombreCompleto}. Cuernavaca, Morelos, México.</p>
      <p>{resumenHorariosCorto}</p>
    </div>
  </div>
</footer>
