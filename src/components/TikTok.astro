---
/**
 * La Cañadita en TikTok: videos con el reproductor oficial
 * (tiktok.com/player/v1/{id}) en 9:16. Los iframes se insertan solo cuando la
 * tarjeta se acerca al viewport o al pulsar reproducir, así la página no
 * descarga embeds pesados al cargar. Columnas escalonadas en escritorio;
 * carrusel con scroll-snap en móvil.
 */
import { tiktoks, idTikTok, contacto } from '../data/site';

const videos = tiktoks
  .map((video) => ({ ...video, id: idTikTok(video.url) }))
  .filter((video): video is { url: string; titulo: string; id: string } => video.id !== null);

const desfase = ['', 'lg:mt-24', 'lg:mt-8', 'lg:mt-32'];
---

{
  videos.length > 0 && (
    <section id="tiktok" data-tono="jardin" class="scroll-mt-20 py-24 md:py-36" aria-labelledby="titulo-tiktok">
      <div class="mx-auto max-w-[1440px] px-5 md:px-6 lg:px-10">
        <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
          <h2 id="titulo-tiktok" data-titular class="display-lg text-azul">
            <span class="mascara"><span data-linea>Lo que pasa</span></span>
            <span class="mascara"><span data-linea><em class="texto-oro pr-2 italic">en la casa.</em></span></span>
          </h2>
          <a href={contacto.redes.tiktok} target="_blank" rel="noopener noreferrer" data-reveal class="boton group self-start bg-azul text-marfil hover:bg-teal md:self-auto">
            @lacanadita.restaurante
            <span class="boton-icono bg-marfil/15">
              <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 5.5a4.9 4.9 0 0 1-3.3-1.3v8.2a4.6 4.6 0 1 1-4.6-4.6c.24 0 .47.02.7.06v2.5a2.1 2.1 0 1 0 1.5 2V2h2.4a4.9 4.9 0 0 0 3.3 3z" /></svg>
            </span>
          </a>
        </div>

        <ul class="sin-barra -mx-5 mt-16 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 md:mx-0 md:mt-20 md:grid md:grid-cols-2 md:gap-6 md:overflow-visible md:px-0 lg:grid-cols-4">
          {videos.map((video, i) => (
            <li data-reveal={String(i)} class:list={['w-[72%] shrink-0 snap-center sm:w-[46%] md:w-auto', desfase[i % 4]]}>
              <article class="tiktok-card relative overflow-hidden rounded-sm bg-azul ring-1 ring-azul/10" data-tiktok-id={video.id}>
                <div class="relative aspect-[9/16] w-full">
                  <button
                    type="button"
                    class="tiktok-play group absolute inset-0 flex h-full w-full flex-col justify-between p-5 text-left text-marfil"
                    aria-label={`Reproducir video: ${video.titulo}`}
                  >
                    <span class="font-display text-sm italic text-marfil/60">0{i + 1}</span>
                    <span class="flex h-14 w-14 items-center justify-center rounded-full bg-oro text-azul-noche transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-110">
                      <svg aria-hidden="true" class="ml-1 h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                    </span>
                  </button>
                </div>
              </article>
              <p class="mt-3 text-sm text-azul/60">{video.titulo}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<script>
  /**
   * Los reproductores de TikTok traen su propio JS (SDK, React, métricas)
   * que sigue corriendo mientras el iframe existe, aunque ya no se vea: en
   * móvil eso le quitaba ~10 ms por frame al scroll del resto de la página.
   * Por eso cada tarjeta monta su iframe al estar en pantalla y lo desmonta
   * al alejarse, salvo que el usuario lo haya usado (se queda reproduciendo).
   */
  function montarTikTok(card: HTMLElement): void {
    if (card.dataset.montado === 'true') return;
    const id = card.dataset.tiktokId;
    const boton = card.querySelector<HTMLButtonElement>('.tiktok-play');
    const contenedor = boton?.parentElement;
    if (!id || !boton || !contenedor) return;
    card.dataset.montado = 'true';

    const iframe = document.createElement('iframe');
    iframe.src =
      `https://www.tiktok.com/player/v1/${id}` +
      '?autoplay=0&loop=1&controls=1&progress_bar=1&music_info=0&description=0&rel=0';
    iframe.title = 'Video de La Cañadita en TikTok';
    iframe.loading = 'lazy';
    iframe.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture';
    iframe.setAttribute('allowfullscreen', '');
    iframe.className = 'absolute inset-0 h-full w-full border-0';
    contenedor.appendChild(iframe);
    boton.hidden = true;
  }

  function desmontarTikTok(card: HTMLElement): void {
    if (card.dataset.montado !== 'true' || card.dataset.usado === 'true') return;
    card.querySelector('iframe')?.remove();
    const boton = card.querySelector<HTMLButtonElement>('.tiktok-play');
    if (boton) boton.hidden = false;
    card.dataset.montado = 'false';
  }

  function iniciarTikTok(): void {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.tiktok-card[data-tiktok-id]'));
    if (cards.length === 0) return;
    cards.forEach((card) =>
      card.querySelector('.tiktok-play')?.addEventListener('click', () => {
        card.dataset.usado = 'true';
        montarTikTok(card);
      }),
    );
    // Tocar dentro de un iframe le quita el foco a la página: así se sabe
    // qué video usó el usuario y ese no se desmonta.
    window.addEventListener('blur', () => {
      const activo = document.activeElement;
      const card = activo instanceof HTMLIFrameElement ? activo.closest<HTMLElement>('.tiktok-card') : null;
      if (card) card.dataset.usado = 'true';
    });
    if (!('IntersectionObserver' in window)) return;

    const libre = (fn: () => void) =>
      'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 1200 }) : setTimeout(fn, 200);
    // Montar: cuando la tarjeta se ve al menos un tercio.
    const alVer = new IntersectionObserver(
      (entradas) =>
        entradas.forEach((e) => {
          const card = e.target as HTMLElement;
          card.dataset.enVista = String(e.isIntersecting);
          if (e.isIntersecting) libre(() => card.dataset.enVista === 'true' && montarTikTok(card));
        }),
      { threshold: 0.35 },
    );
    // Desmontar: cuando ya quedó lejos de la pantalla.
    const alSalir = new IntersectionObserver(
      (entradas) =>
        entradas.forEach((e) => {
          if (!e.isIntersecting) desmontarTikTok(e.target as HTMLElement);
        }),
      { rootMargin: '150px' },
    );
    cards.forEach((card) => {
      alVer.observe(card);
      alSalir.observe(card);
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', iniciarTikTok, { once: true });
  else iniciarTikTok();
</script>
