---
/**
 * Nuestra casa: el manifiesto se ilumina palabra por palabra mientras se lee
 * y lo acompaña el horario de la casa, compuesto como el letrero de una
 * puerta: día, línea punteada y hora. La tipografía es la protagonista.
 */
import TextoIluminado from './TextoIluminado.astro';
import { horarios } from '../data/horarios';
import { contacto } from '../data/site';

/** "08:00" → "8:00". */
const hora = (h: string) => h.replace(/^0/, '');
const tramo = (t: { apertura: string; cierre: string }) => `${hora(t.apertura)} – ${hora(t.cierre)}`;

const filas = [
  { dia: horarios.entreSemana.etiqueta, valor: tramo(horarios.entreSemana) },
  { dia: horarios.finDeSemana.etiqueta, valor: tramo(horarios.finDeSemana) },
];
---

<section id="experiencia" data-tono="salvia" class="scroll-mt-20 py-24 md:py-36" aria-labelledby="titulo-experiencia">
  <div class="mx-auto max-w-[1440px] px-5 md:px-6 lg:px-10">
    <h2 id="titulo-experiencia" class="sr-only">Nuestra casa</h2>
    <TextoIluminado
      class="font-display text-[clamp(2.2rem,5.4vw,5.8rem)] leading-[1.04] tracking-[-0.025em] text-olivo"
      texto="En el corazón de Cuernavaca, una casa con jardín donde la cocina mexicana llega *recién hecha* a la mesa, con ingredientes frescos, técnica y herencia culinaria, y una sobremesa que *dura lo que tú quieras.*"
    />

    <div class="mt-20 md:mt-28 md:grid md:grid-cols-12 md:gap-10">
      <dl data-reveal class="horario md:col-span-7 md:col-start-6" aria-label="Horario y reservaciones">
        {
          filas.map((f) => (
            <div class="horario-fila">
              <dt class="horario-dia">{f.dia}</dt>
              <span class="horario-puntos" aria-hidden="true"></span>
              <dd class="horario-valor">{f.valor}</dd>
            </div>
          ))
        }
        <div class="horario-fila">
          <dt class="horario-dia">
            Reservaciones
            <span class="mt-0.5 block text-[0.78rem] font-medium text-oro-oscuro">Teléfono y WhatsApp</span>
          </dt>
          <span class="horario-puntos" aria-hidden="true"></span>
          <dd class="horario-valor">
            <a href={contacto.telefono.href} class="enlace">{contacto.telefono.visible}</a>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>
