---
/**
 * Navegación móvil (<768 px).
 *
 * - Dock de vidrio inferior: Menú (izquierda), Inicio (centro), Más (derecha).
 * - Botón flotante de reserva (agenda) sobre el dock, a la derecha. Cada
 *   cierto tiempo despliega hacia la izquierda una etiqueta con frases que
 *   se relevan: Reserva, Contacta, Disfruta. Abre WhatsApp.
 * - Overlay a pantalla completa con acciones rápidas ("Más").
 * En tablet/escritorio se oculta y la navegación vive en Header.astro, cuyo
 * script también anima la píldora de este dock.
 *
 * Accesibilidad: aria-expanded/aria-controls en "Más", foco atrapado en el
 * overlay, cierre con Escape y con la X, scroll bloqueado y foco devuelto al
 * cerrar. Las frases del botón son decorativas (aria-hidden); su nombre
 * accesible es fijo. Iconos: Phosphor (Icono.astro).
 */
import Icono from './Icono.astro';
import { accionesRapidas, contacto, enlaceWhatsApp, ancla } from '../data/site';

const ruta = Astro.url.pathname;
const whatsappReserva = enlaceWhatsApp(contacto.whatsapp.mensajeReserva);

const frases = ['Reserva', 'Contacta', 'Disfruta'];

/** Columna activa del dock (0 Menú, 1 Inicio); null si ninguna aplica. */
const indiceActivo = ruta.startsWith('/menu') ? 0 : ruta === '/' ? 1 : null;
---

<!-- Dock de navegación inferior (solo móvil) -->
<nav
  id="barra-inferior"
  aria-label="Navegación principal móvil"
  class="chrome-barra fixed inset-x-0 bottom-[calc(0.75rem_+_env(safe-area-inset-bottom))] z-40 flex justify-center md:hidden"
>
  <div data-dock data-dock-css class="dock dock-vidrio w-[min(20rem,calc(100%-1.5rem))] rounded-full p-1.5">
    <div
      data-dock-pista
      data-indice-inicial={indiceActivo ?? undefined}
      class="relative"
      style={indiceActivo !== null ? `--i: ${indiceActivo}` : undefined}
    >
      <span
        data-dock-indicador
        data-visible={indiceActivo !== null ? '' : undefined}
        class="dock-indicador"
        aria-hidden="true"
      ></span>
      <ul class="dock-fila relative grid grid-cols-3 items-center gap-1">
        <li>
          <a
            href="/menu/"
            data-dock-item
            aria-current={ruta.startsWith('/menu') ? 'page' : undefined}
            class="dock-item dock-item-movil"
          >
            <Icono nombre="cubiertos" class="icono-normal h-[1.35rem] w-[1.35rem]" />
            <Icono nombre="cubiertosLlena" class="icono-activo h-[1.35rem] w-[1.35rem]" />
            <span>Menú</span>
          </a>
        </li>
        <li>
          <a
            href={ancla('#inicio', ruta)}
            data-dock-item
            aria-current={ruta === '/' ? 'page' : undefined}
            class="dock-item dock-item-movil"
          >
            <Icono nombre="casa" class="icono-normal h-[1.35rem] w-[1.35rem]" />
            <Icono nombre="casaLlena" class="icono-activo h-[1.35rem] w-[1.35rem]" />
            <span>Inicio</span>
          </a>
        </li>
        <li>
          <button
            id="boton-mas"
            type="button"
            data-dock-item
            aria-expanded="false"
            aria-controls="menu-rapido"
            class="dock-item dock-item-movil"
          >
            <Icono nombre="mas" class="icono-normal h-[1.35rem] w-[1.35rem]" />
            <Icono nombre="masLlena" class="icono-activo h-[1.35rem] w-[1.35rem]" />
            <span>Más</span>
          </button>
        </li>
      </ul>
    </div>
  </div>
</nav>

<!-- Botón flotante de reserva: agenda + frases que salen hacia la izquierda -->
<a
  id="fab-reserva"
  href={whatsappReserva}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Reservar mesa por WhatsApp"
  class="fab fixed bottom-[calc(5.75rem_+_env(safe-area-inset-bottom))] right-4 z-40 md:hidden"
>
  <span class="fab-etiqueta" aria-hidden="true">
    <span class="fab-frases">
      {frases.map((f) => <span class="fab-frase">{f}</span>)}
    </span>
  </span>
  <span class="fab-boton">
    <Icono nombre="agenda" class="h-6 w-6" />
  </span>
</a>

<!-- Overlay de acciones rápidas: velo translúcido, marca arriba y opciones
     centradas, sin divisiones. -->
<div
  id="menu-rapido"
  role="dialog"
  aria-modal="true"
  aria-label="Acciones rápidas"
  hidden
  class="menu-rapido fixed inset-0 z-50 flex flex-col pb-[calc(1.5rem_+_env(safe-area-inset-bottom))] pt-[env(safe-area-inset-top)] md:hidden"
>
  <div class="relative flex justify-end px-5 pt-4">
    <button
      id="boton-cerrar-mas"
      type="button"
      aria-label="Cerrar menú"
      class="flex h-11 w-11 items-center justify-center rounded-full bg-marfil/10 text-marfil transition-colors hover:bg-marfil hover:text-azul"
    >
      <Icono nombre="cerrar" class="h-5 w-5" />
    </button>
  </div>

  <div class="flex flex-1 flex-col items-center justify-center overflow-y-auto px-6 pb-6 text-center">
    <div class="menu-rapido-marca flex flex-col items-center gap-3">
      <img
        src="/logo-oscuro-200.webp"
        alt=""
        aria-hidden="true"
        width={184}
        height={200}
        loading="lazy"
        decoding="async"
        class="h-20 w-auto brightness-0 invert"
      />
      <span class="font-display text-[1.7rem] leading-none text-marfil">La Cañadita</span>
    </div>

    <ul class="mt-12 flex flex-col items-center gap-2">
      {
        accionesRapidas.map((accion) => (
          <li>
            <a
              href={ancla(accion.href, ruta)}
              {...(accion.externo ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class="menu-rapido-enlace inline-flex min-h-12 items-center whitespace-nowrap px-4 font-sans text-[1.3rem] font-medium leading-none tracking-[-0.01em] text-marfil transition-colors hover:text-oro"
            >
              {accion.etiqueta}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="text-center text-sm text-marfil/70">
    O llámanos al
    <a href={contacto.telefono.href} class="text-marfil underline underline-offset-4">
      {contacto.telefono.visible}
    </a>
  </p>
</div>

<script>
  /** Comportamiento del overlay: foco atrapado, Escape, scroll bloqueado. */
  function iniciarNavegacionMovil(): void {
    const boton = document.getElementById<HTMLButtonElement>('boton-mas');
    const overlay = document.getElementById<HTMLElement>('menu-rapido');
    const botonCerrar = document.getElementById<HTMLButtonElement>('boton-cerrar-mas');
    if (!boton || !overlay || !botonCerrar) return;
    overlay.dataset.listos = 'true';

    const bloqueables = document.querySelectorAll<HTMLElement>('header, main, footer, #barra-inferior');
    let ultimoFoco: HTMLElement | null = null;
    let temporizadorCierre: ReturnType<typeof setTimeout> | null = null;

    const elementosFocuseables = () =>
      Array.from(
        overlay.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      );

    const estaAbierto = () => overlay.getAttribute('data-estado') === 'abierto';

    function abrir(): void {
      if (temporizadorCierre) clearTimeout(temporizadorCierre);
      ultimoFoco = document.activeElement as HTMLElement | null;
      overlay.hidden = false;
      overlay.setAttribute('data-estado', 'abierto');
      boton.setAttribute('aria-expanded', 'true');
      boton.dataset.abierto = 'true';
      document.body.classList.add('sin-scroll');
      bloqueables.forEach((elemento) => elemento.setAttribute('inert', ''));
      elementosFocuseables()[0]?.focus();
    }

    function finalizarCierre(): void {
      overlay.hidden = true;
      overlay.removeAttribute('data-estado');
      document.body.classList.remove('sin-scroll');
      bloqueables.forEach((elemento) => elemento.removeAttribute('inert'));
      (ultimoFoco ?? boton).focus();
    }

    function cerrar(): void {
      if (!estaAbierto()) return;
      boton.setAttribute('aria-expanded', 'false');
      delete boton.dataset.abierto;
      overlay.setAttribute('data-estado', 'cerrando');
      // El overlay se oculta al terminar la animación de salida (200 ms).
      temporizadorCierre = setTimeout(finalizarCierre, 260);
    }

    function alPresionarTecla(evento: KeyboardEvent): void {
      if (!estaAbierto()) return;
      if (evento.key === 'Escape') {
        evento.preventDefault();
        cerrar();
        return;
      }
      if (evento.key !== 'Tab') return;
      // Foco atrapado: el Tab recorre solo los elementos del overlay.
      const foco = elementosFocuseables();
      const primero = foco[0];
      const ultimo = foco[foco.length - 1];
      if (!primero || !ultimo) return;
      if (evento.shiftKey && document.activeElement === primero) {
        evento.preventDefault();
        ultimo.focus();
      } else if (!evento.shiftKey && document.activeElement === ultimo) {
        evento.preventDefault();
        primero.focus();
      }
    }

    boton.addEventListener('click', () => (estaAbierto() ? cerrar() : abrir()));
    botonCerrar.addEventListener('click', cerrar);
    overlay.querySelectorAll<HTMLElement>('.menu-rapido-enlace').forEach((enlace) => {
      enlace.addEventListener('click', cerrar);
    });
    document.addEventListener('keydown', alPresionarTecla);
  }

  /**
   * Arranque: inmediato con carga normal y también en cada `astro:page-load`.
   * El guard por elemento evita registrar los listeners dos veces.
   */
  function iniciar(): void {
    const overlay = document.getElementById('menu-rapido');
    if (!overlay || overlay.dataset.listos === 'true') return;
    iniciarNavegacionMovil();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciar, { once: true });
  } else {
    iniciar();
  }
  document.addEventListener('astro:page-load', iniciar);

  /**
   * Botón de reserva: aparece a partir de "Nuestra casa" (#experiencia) y se
   * queda de ahí hacia abajo; arriba no estorba al hero ni a la cinta.
   * Fuera de la home se muestra siempre.
   */
  function iniciarFab(): void {
    const fab = document.getElementById('fab-reserva');
    if (!fab || fab.dataset.listo === 'true') return;
    fab.dataset.listo = 'true';
    const desde = document.getElementById('experiencia');
    if (!desde) {
      fab.setAttribute('data-visible', '');
      return;
    }
    // Una sola lectura por frame (rAF): sin layout forzado repetido aunque
    // lleguen muchos eventos de scroll. (Un IntersectionObserver no detecta
    // saltos directos de abajo hacia arriba, p. ej. "volver al inicio".)
    let pendiente = false;
    const actualizar = () => {
      pendiente = false;
      fab.toggleAttribute('data-visible', desde.getBoundingClientRect().top < window.innerHeight * 0.75);
    };
    const pedir = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(actualizar);
    };
    window.addEventListener('scroll', pedir, { passive: true });
    window.addEventListener('resize', pedir, { passive: true });
    actualizar();
  }
  iniciarFab();
  document.addEventListener('astro:page-load', iniciarFab);

  /**
   * Píldora del dock: la posición inicial ya viene del servidor (--i). Al
   * tocar un enlace a otra página, la píldora y el icono relleno se deslizan
   * al destino y después se navega. Si se vuelve con "atrás" (bfcache) se
   * restaura el estado original.
   */
  function iniciarPildora(): void {
    const pista = document.querySelector<HTMLElement>('#barra-inferior [data-dock-pista]');
    if (!pista || pista.dataset.listo === 'true') return;
    pista.dataset.listo = 'true';
    const indicador = pista.querySelector<HTMLElement>('[data-dock-indicador]');
    const items = Array.from(pista.querySelectorAll<HTMLElement>('[data-dock-item]'));
    if (!indicador) return;
    const inicial = items.find((i) => i.hasAttribute('aria-current')) ?? null;

    const marcar = (destino: HTMLElement | null): void => {
      items.forEach((i) => i.toggleAttribute('data-activo', i === destino));
      items.forEach((i) => {
        if (i !== destino) i.removeAttribute('aria-current');
      });
      if (destino) destino.setAttribute('aria-current', 'page');
      const indice = destino ? items.indexOf(destino) : -1;
      if (indice < 0) {
        indicador.removeAttribute('data-visible');
        return;
      }
      pista.style.setProperty('--i', String(indice));
      indicador.setAttribute('data-visible', '');
    };

    const reducir = window.matchMedia('(prefers-reduced-motion: reduce)');
    let navegando = false;

    items.forEach((item) => {
      if (!(item instanceof HTMLAnchorElement)) return;
      item.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const destino = new URL(item.href);
        // Solo navegaciones a otra página: un ancla en la misma no cambia el activo.
        if (destino.pathname === location.pathname) return;
        // Cada cambio de página es una carga completa: la píldora se desliza
        // primero (con la página actual aún viva, sin trabarse) y luego se
        // navega. La página nueva ya trae la píldora en el mismo lugar.
        e.preventDefault();
        if (navegando) return;
        navegando = true;
        marcar(item);
        window.setTimeout(() => location.assign(item.href), reducir.matches ? 0 : 340);
      });
    });

    window.addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      navegando = false;
      marcar(inicial);
    });
  }
  iniciarPildora();
  document.addEventListener('astro:page-load', iniciarPildora);
</script>
