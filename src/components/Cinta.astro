---
/**
 * Cinta de servicios en movimiento: la única del sitio. Resume lo que ofrece
 * el restaurante justo debajo del hero. Se pausa con el puntero y se detiene
 * con prefers-reduced-motion. La copia del bucle está oculta para lectores.
 */
const servicios = [
  'Desayunos',
  'Comida',
  'Buffet sabatino',
  'Brunch dominical',
  'Jardines',
  'Av. Compositores 202',
];
---

<div class="overflow-hidden border-y border-olivo/15 py-5" aria-label="Servicios de La Cañadita">
  <div class="cinta">
    {
      [0, 1].map((copia) => (
        <ul class="flex shrink-0 items-center" aria-hidden={copia === 1 ? 'true' : undefined}>
          {servicios.map((servicio) => (
            <li class="flex items-center">
              <span class="px-7 font-display text-[clamp(1.6rem,3vw,2.6rem)] italic leading-none text-olivo/85">
                {servicio}
              </span>
              <span aria-hidden="true" class="h-px w-8 bg-oro-oscuro/40"></span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>
