---
/**
 * Sección de menú de la home: selección breve de platillos tomados de la
 * carta completa (menu.ts + menu.json) con enlace a /menu. La carta
 * completa vive en la vista /menu.
 */
import Imagen from './Imagen.astro';
import { menuSugerencias } from '../data/menu';
import menuDatos from '../data/menu.json';

const platillosChef = menuSugerencias.flatMap((categoria) => categoria.platillos);
const desayunos = (
  menuDatos as unknown as { desayunos: { items: { nombre: string; precio: number }[] }[] }
).desayunos.flatMap((categoria) => categoria.items);

/** Selección breve; los precios se leen de los archivos de datos (no se repiten a mano). */
const muestra: { nombre: string; precio: string }[] = [
  {
    nombre: 'Trilogía de maíz',
    precio: platillosChef.find((platillo) => platillo.nombre === 'Trilogía de maíz')?.precio ?? '',
  },
  {
    nombre: 'Tostado Jardín',
    precio: `$${desayunos.find((platillo) => platillo.nombre === 'Tostado Jardín')?.precio ?? 0}`,
  },
  {
    nombre: 'Pulpo ahumado',
    precio: platillosChef.find((platillo) => platillo.nombre === 'Pulpo ahumado')?.precio ?? '',
  },
  {
    nombre: 'Chilaquiles Fundidos',
    precio: `$${desayunos.find((platillo) => platillo.nombre === 'Chilaquiles Fundidos')?.precio ?? 0}`,
  },
  {
    nombre: 'Medallón de res a la pimienta 200 g',
    precio:
      platillosChef.find((platillo) => platillo.nombre === 'Medallón de res a la pimienta 200 g')
        ?.precio ?? '',
  },
  {
    nombre: 'Churros de mesa',
    precio: platillosChef.find((platillo) => platillo.nombre === 'Churros de mesa')?.precio ?? '',
  },
];
---

<section
  id="menu"
  class="fusion-verde-beige scroll-mt-20 bg-beige py-20 md:py-28"
  aria-labelledby="titulo-menu"
>
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 md:grid-cols-2 md:gap-16 lg:px-8">
    <!-- Texto a la izquierda; imagen a la derecha en desktop -->
    <div>
      <p class="antetitulo mb-4 text-verde-suave">Menú</p>
      <h2 id="titulo-menu" class="text-4xl text-verde sm:text-5xl">
        Una carta para <em class="font-normal italic">volver.</em>
      </h2>
      <p class="mt-6 max-w-[54ch] text-[0.98rem] leading-relaxed text-tinta/80">
        Del desayuno al postre: sugerencias del chef, chilaquiles, tostados, mariscos, carnes y
        bebidas, elaborados al momento. Esta es solo una muestra.
      </p>

      <ul class="mt-8 max-w-[54ch]">
        {
          muestra.map((platillo) => (
            <li class="flex items-baseline gap-3 border-b border-verde/20 py-3">
              <span class="text-[1.02rem] font-semibold text-tinta">{platillo.nombre}</span>
              <span aria-hidden="true" class="leader flex-1"></span>
              <span class="shrink-0 text-[1.02rem] font-semibold tabular-nums text-verde">
                {platillo.precio}
              </span>
            </li>
          ))
        }
      </ul>

      <a
        href="/menu/"
        class="mt-8 inline-flex items-center gap-2 bg-verde px-7 py-3.5 text-sm font-semibold uppercase tracking-[0.12em] text-marfil transition-colors hover:bg-verde-oscuro"
      >
        Ver menú completo
        <svg
          aria-hidden="true"
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>

    <div class="relative md:translate-y-4">
      <Imagen
        nombre="croissants"
        alt="Croissants recién horneados con glaseado de chocolate en el jardín de La Cañadita"
        class="aspect-[4/3] w-full object-cover"
        sizes="(min-width: 768px) 50vw, 100vw"
      />
    </div>
  </div>
</section>
