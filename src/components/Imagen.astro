---
/**
 * Imagen optimizada en WebP con srcset generado por scripts/prepare-assets.py.
 * Las versiones disponibles son: principal, -768 y -1280 (cuando el archivo
 * principal lo permite).
 */
interface Props {
  nombre: string;
  alt: string;
  /** Clases de Tailwind para el elemento (object-cover, aspect-*, etc.). */
  class?: string;
  /** Tamaños responsivos para el navegador. */
  sizes?: string;
  /** Carga prioritaria solo para la imagen principal de la página. */
  prioritaria?: boolean;
  /** Visible al cargar pero no es la principal: sin lazy, prioridad normal. */
  inmediata?: boolean;
  /** Recorte del contenedor para móvil y escritorio. */
  objectPosition?: string;
}

const { nombre, alt, class: clase = '', sizes = '100vw', prioritaria = false, inmediata = false, objectPosition } = Astro.props;

/** Ancho y alto reales de cada archivo generado. */
const DIMENSIONES: Record<string, [number, number]> = {
  exterior: [1016, 514],
  pulpo: [1036, 826],
  ceviche: [1080, 812],
  'desayuno-mesa': [1004, 594],
  medallon: [1004, 452],
  churros: [1004, 547],
  peras: [972, 716],
  omelette: [950, 730],
  'buffet-copas': [1800, 1080],
  'hero-jardin': [1920, 1440],
  terraza: [1600, 1200],
  barra: [1448, 1086],
  'buffet-sopas': [1440, 1440],
  panaderia: [1800, 1200],
  'buffet-fuentes': [1920, 1776],
  'brunch-familia': [1920, 1152],
  'tiktok-7646937477302717716': [720, 1280],
  'tiktok-7699315580049853716': [480, 848],
  'tiktok-7646937652897385748': [720, 1280],
  'tiktok-7653625140671941909': [720, 1280],
  capirotada: [1440, 1920],
  'evento-chimenea': [1448, 1086],
  'evento-pergola': [1448, 1086],
  'evento-mesa-privada': [1448, 1086],
  'evento-ceremonia': [1448, 1086],
  'evento-herradura': [1448, 1086],
  'evento-corporativo': [1448, 1086],
  'evento-celebracion': [1086, 1448],
  'evento-salon-jardin': [1448, 1086],
};

const [ancho, alto] = DIMENSIONES[nombre] ?? [1600, 1200];

const srcset = (ext: 'avif' | 'webp'): string => {
  const variantes = [`/img/${nombre}.${ext} ${ancho}w`];
  if (ancho > 768) variantes.unshift(`/img/${nombre}-768.${ext} 768w`);
  if (ancho > 1280) variantes.splice(1, 0, `/img/${nombre}-1280.${ext} 1280w`);
  return variantes.join(', ');
};

const posicion = objectPosition ? { 'object-position': objectPosition } : {};
---

<!-- AVIF pesa ~35% menos; los navegadores sin soporte toman el WebP del <img>.
     `contents` deja el <picture> fuera del layout: los estilos de `img` no cambian. -->
<picture class="contents">
  <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
  <img
    src={`/img/${nombre}.webp`}
    srcset={srcset('webp')}
    sizes={sizes}
    {alt}
    width={ancho}
    height={alto}
    loading={prioritaria || inmediata ? 'eager' : 'lazy'}
    decoding={prioritaria ? 'sync' : 'async'}
    fetchpriority={prioritaria ? 'high' : 'auto'}
    class={clase}
    style={posicion}
  />
</picture>
