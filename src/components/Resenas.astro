---
/**
 * Reseñas de comensales como notas pegadas en la pared de la casa.
 * La principal al centro (su texto se ilumina con el scroll); una nota
 * arriba a la derecha y otra abajo a la izquierda, giradas y montadas en
 * las esquinas de la central para ocupar poco espacio.
 * Los textos se recortan para leerse de un vistazo.
 */
import TextoIluminado from './TextoIluminado.astro';

const principal = {
  texto: 'Servicio más que excelente, la comida muy buena, instalaciones muy cuidadas, *bellos jardines.*',
  autor: 'Wendy Toledo',
};
const secundarias = [
  {
    texto: 'Hermoso lugar, los desayunos buenísimos. Desayunito rodeado de un hermoso jardín.',
    autor: 'Angie Vega',
    clase: 'nota-salvia nota-arriba',
  },
  {
    texto: 'Espectacular jardín, cómodo y muy bien cuidado. La comida del restaurante es muy buena.',
    autor: 'B.A.S.D',
    clase: 'nota-azulejo nota-abajo',
  },
];
---

<section data-tono="teal" class="relative py-24 md:py-36" aria-labelledby="titulo-resenas">
  <div class="mx-auto max-w-[1440px] px-5 md:px-6 lg:px-10">
    <h2 id="titulo-resenas" class="sr-only">Lo que dicen nuestros comensales</h2>

    <div class="notas">
      <figure data-reveal="1" class:list={['nota', secundarias[0].clase]}>
        <blockquote class="nota-texto"><p>“{secundarias[0].texto}”</p></blockquote>
        <figcaption class="nota-autor">{secundarias[0].autor}</figcaption>
      </figure>

      <figure class="nota nota-papel nota-centro">
        <span class="flex gap-0.5 text-oro-oscuro" role="img" aria-label="5 de 5 estrellas">
          {Array.from({ length: 5 }).map(() => (
            <svg aria-hidden="true" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.1l-4.95 2.6.95-5.5-4-3.9 5.53-.8L10 1.5z" /></svg>
          ))}
        </span>
        <TextoIluminado
          como="blockquote"
          class="mt-4 font-display text-[clamp(1.7rem,3.6vw,3rem)] leading-[1.08] tracking-[-0.015em] text-azul"
          texto={principal.texto}
        />
        <figcaption class="nota-autor mt-6">{principal.autor}</figcaption>
      </figure>

      <figure data-reveal="2" class:list={['nota', secundarias[1].clase]}>
        <blockquote class="nota-texto"><p>“{secundarias[1].texto}”</p></blockquote>
        <figcaption class="nota-autor">{secundarias[1].autor}</figcaption>
      </figure>
    </div>
  </div>
</section>
