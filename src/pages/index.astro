---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Cinta from '../components/Cinta.astro';
import Experiencia from '../components/Experiencia.astro';
import MenuCarta from '../components/MenuCarta.astro';
import Buffet from '../components/Buffet.astro';
import Resenas from '../components/Resenas.astro';
import Galeria from '../components/Galeria.astro';
import Eventos from '../components/Eventos.astro';
import TikTok from '../components/TikTok.astro';
import Ubicacion from '../components/Ubicacion.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { sitio, contacto } from '../data/site';
import { horarios } from '../data/horarios';
import { preguntas } from '../data/faq';

const titulo = 'La Cañadita Restaurant · Cocina mexicana entre jardines en Cuernavaca, Morelos';
const descripcion =
  'Restaurante con jardín en Cuernavaca: desayunos, comida, buffet los sábados y brunch los domingos. Av. Compositores 202, Col. Analco. Reservaciones al 777 781 00 03.';

/** Datos estructurados del restaurante (solo información confirmada). */
const restaurante = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': `${sitio.url}/#restaurante`,
  name: sitio.nombreCompleto,
  url: sitio.url,
  image: `${sitio.url}/og-image.jpg`,
  logo: `${sitio.url}/logo-oscuro.png`,
  description: sitio.descripcion,
  servesCuisine: ['Mexicana contemporánea', 'Desayunos', 'Brunch'],
  acceptsReservations: true,
  currenciesAccepted: 'MXN',
  telephone: '+527777810003',
  address: {
    '@type': 'PostalAddress',
    streetAddress: contacto.direccion.linea1,
    addressLocality: contacto.direccion.ciudad,
    addressRegion: contacto.direccion.estado,
    addressCountry: 'MX',
  },
  hasMap: contacto.maps.url,
  sameAs: [contacto.redes.facebook, contacto.redes.instagram, contacto.redes.tiktok],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: horarios.entreSemana.apertura,
      closes: horarios.entreSemana.cierre,
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday', 'Sunday'],
      opens: horarios.finDeSemana.apertura,
      closes: horarios.finDeSemana.cierre,
    },
  ],
  hasMenu: `${sitio.url}/menu/`,
};

/** Preguntas frecuentes en formato FAQPage (mismo texto visible en la página). */
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.map((p) => ({
    '@type': 'Question',
    name: p.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: p.respuesta },
  })),
};
---

<BaseLayout titulo={titulo} descripcion={descripcion}>
  <Hero />
  <Cinta />
  <Experiencia />
  <MenuCarta />
  <Buffet />
  <Resenas />
  <Galeria />
  <Eventos />
  <TikTok />
  <Ubicacion />
  <CtaFinal />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(restaurante)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faq)} />
</BaseLayout>
