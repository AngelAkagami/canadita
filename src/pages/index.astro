---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Experiencia from '../components/Experiencia.astro';
import Resenas from '../components/Resenas.astro';
import MenuCarta from '../components/MenuCarta.astro';
import Buffet from '../components/Buffet.astro';
import Brunch from '../components/Brunch.astro';
import Horarios from '../components/Horarios.astro';
import Galeria from '../components/Galeria.astro';
import Ubicacion from '../components/Ubicacion.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { sitio, contacto } from '../data/site';

const titulo = 'La Cañadita Restaurant · Cocina contemporánea en Cuernavaca, Morelos';
const descripcion =
  'Descubre La Cañadita, un espacio para compartir la mesa, disfrutar buenos sabores y convertir cada visita en una experiencia especial. En Av. Compositores 202, Col. Analco, Cuernavaca, Morelos.';

/** Datos estructurados con la información oficial disponible. */
const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: sitio.nombreCompleto,
  url: sitio.url,
  image: `${sitio.url}/og-image.jpg`,
  description: sitio.descripcion,
  servesCuisine: 'Cocina mexicana contemporánea',
  telephone: '+527777810003',
  address: {
    '@type': 'PostalAddress',
    streetAddress: contacto.direccion.linea1,
    addressLocality: contacto.direccion.ciudad,
    addressRegion: contacto.direccion.estado,
    addressCountry: 'MX',
  },
  sameAs: [contacto.redes.facebook, contacto.redes.instagram],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday', 'Sunday'],
      opens: '09:00',
      closes: '18:00',
    },
  ],
  hasMenu: `${sitio.url}/menu/`,
};
---

<BaseLayout titulo={titulo} descripcion={descripcion}>
  <Hero />
  <Experiencia />
  <Resenas />
  <MenuCarta />
  <Buffet />
  <Brunch />
  <Horarios />
  <Galeria />
  <Ubicacion />
  <CtaFinal />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(datosEstructurados)} />
</BaseLayout>
