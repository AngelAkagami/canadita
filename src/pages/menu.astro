---
/**
 * Vista de la carta completa (/menu): sugerencias del chef (menu.ts),
 * desayunos y bebidas (menu.json). Categorías con chips sticky, imagen
 * alterna por categoría y precios alineados a la derecha.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuCategoria from '../components/MenuCategoria.astro';
import Icono from '../components/Icono.astro';
import Ornamento from '../components/Ornamento.astro';
import { menuSugerencias } from '../data/menu';
import menuDatos from '../data/menu.json';
import { pesos } from '../data/horarios';
import { contacto, enlaceWhatsApp } from '../data/site';

const whatsappCarta = enlaceWhatsApp(contacto.whatsapp.mensajeCarta);

/** Tipado del JSON de la carta (los campos `todo` no se renderizan). */
interface PlatoDesayuno {
  nombre: string;
  precio: number;
  descripcion?: string;
  variantes?: string[];
  todo?: string;
}
interface DatosMenu {
  desayunos: { categoria: string; items: PlatoDesayuno[] }[];
  bebidas: {
    jugos: {
      tamanos: string[];
      items: { nombre: string; precio: [number, number]; descripcion?: string }[];
    };
    calientes: { nombre: string; precio: number; todo?: string }[];
  };
}
const datos = menuDatos as unknown as DatosMenu;

/** Slug de ancla para categorías del JSON ("Chilaquiles y moles" → "chilaquiles-y-moles"). */
const slug = (texto: string) =>
  texto
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

/**
 * Foto de cada categoría. `null` = sin foto honesta disponible → placeholder
 * con TODO (no se generan ni buscan fotos de comida).
 */
const IMAGENES: Record<string, { nombre: string; alt: string } | null> = {
  entradas: { nombre: 'ceviche', alt: 'Ceviche servido en plato de talavera con crema de coco' },
  'cremas-y-sopas': {
    nombre: 'buffet-sopas',
    alt: 'Fuentes de sopa y consomé en la línea del buffet al jardín',
  },
  ensaladas: null,
  pastas: null,
  aves: null,
  'pescados-y-mariscos': {
    nombre: 'pulpo',
    alt: 'Pulpo ahumado sobre puré de camote con espárragos',
  },
  carnes: {
    nombre: 'medallon',
    alt: 'Medallón de res a la pimienta con puré de camote y espárragos',
  },
  postres: { nombre: 'churros', alt: 'Churros de mesa con trilogía de helados artesanales' },
  'dulces-y-frescos': {
    nombre: 'capirotada',
    alt: 'Pan dulce con crema, fresas, moras y frutas de temporada',
  },
  'tostados-y-omelette': {
    nombre: 'omelette',
    alt: 'Omelette de flor de calabaza con ensalada fresca',
  },
  'huevos-y-antojitos': null,
  'chilaquiles-y-moles': {
    nombre: 'desayuno-mesa',
    alt: 'Mesa de desayuno con chilaquiles, jugo de naranja y fruta fresca',
  },
  extras: null,
  jugos: null,
  'bebidas-calientes': null,
};

const chef = menuSugerencias.map((categoria) => ({
  id: categoria.id,
  nombre: categoria.nombre,
  grupo: 'Sugerencias del chef',
  imagen: IMAGENES[categoria.id] ?? null,
  items: categoria.platillos.map((platillo) => ({
    nombre: platillo.nombre,
    descripcion: platillo.descripcion,
    precio: platillo.precio,
    nota: platillo.nota,
  })),
}));

const desayunos = datos.desayunos.map((categoria) => ({
  id: slug(categoria.categoria),
  nombre: categoria.categoria,
  grupo: 'Desayunos',
  imagen: IMAGENES[slug(categoria.categoria)] ?? null,
  items: categoria.items.map((platillo) => ({
    nombre: platillo.nombre,
    descripcion: platillo.descripcion,
    precio: pesos(platillo.precio),
    variantes: platillo.variantes,
  })),
}));

const jugos = {
  id: 'jugos',
  nombre: 'Jugos naturales',
  grupo: 'Bebidas',
  imagen: IMAGENES['jugos'] ?? null,
  columnas: datos.bebidas.jugos.tamanos,
  items: datos.bebidas.jugos.items.map((jugo) => ({
    nombre: jugo.nombre,
    descripcion: jugo.descripcion,
    precios: jugo.precio.map(pesos),
  })),
};

const calientes = {
  id: 'bebidas-calientes',
  nombre: 'Bebidas calientes',
  grupo: 'Bebidas',
  imagen: IMAGENES['bebidas-calientes'] ?? null,
  items: datos.bebidas.calientes.map((bebida) => ({
    nombre: bebida.nombre,
    precio: pesos(bebida.precio),
  })),
};

/** Las imágenes alternan de lado de forma estricta entre categorías. */
const secciones = [...chef, ...desayunos, jugos, calientes].map((seccion, indice) => ({
  ...seccion,
  invertir: indice % 2 === 1,
}));

const chips = secciones.map((seccion) => ({ href: `#${seccion.id}`, etiqueta: seccion.nombre }));

const totalPlatillos = secciones.reduce((suma, seccion) => suma + seccion.items.length, 0);

/** Índice de la portada: los tres apartados de la carta con su número de platillos. */
const cuenta = (grupo: string) =>
  secciones.filter((s) => s.grupo === grupo).reduce((suma, s) => suma + s.items.length, 0);
const indice = [
  { numeral: 'I', nombre: 'Sugerencias del chef', href: '#grupo-chef', total: cuenta('Sugerencias del chef') },
  { numeral: 'II', nombre: 'Desayunos', href: '#grupo-desayunos', total: cuenta('Desayunos') },
  { numeral: 'III', nombre: 'Bebidas', href: '#grupo-bebidas', total: cuenta('Bebidas') },
];

/** Platillos reales que el buscador "escribe" como sugerencia. */
const sugerencias = [
  ...menuSugerencias.flatMap((categoria) => categoria.platillos.slice(0, 1).map((p) => p.nombre)),
  ...datos.desayunos
    .filter((categoria) => categoria.categoria !== 'Extras')
    .flatMap((categoria) => categoria.items.slice(0, 1).map((p) => p.nombre)),
].map((nombre) => nombre.replace(/\s*\(.*?\)/g, ''));
---

<BaseLayout
  titulo="Menú — Carta completa de La Cañadita Restaurant"
  descripcion="Sugerencias del chef, desayunos, jugos y bebidas calientes de La Cañadita Restaurant en Cuernavaca, Morelos. Precios en pesos mexicanos."
>
  <header class="pb-10 pt-14 md:pb-16 md:pt-36">
    <div class="mx-auto max-w-[1400px] px-5 md:px-6 lg:px-10">
      <div class="md:grid md:grid-cols-[1.1fr_1fr] md:items-end md:gap-16">
        <div>
          <Ornamento variante="oscuro" class="h-11 w-auto opacity-80" />
          <h1 class="display-xl mt-5 text-olivo">La carta</h1>
          <p class="mt-4 text-[0.9rem] text-tinta/60">
            {totalPlatillos} platillos, precios en pesos mexicanos.
          </p>
        </div>
        <ol class="carta-indice mt-10 md:mt-0">
          {
            indice.map((apartado) => (
              <li>
                <a href={apartado.href}>
                  <span class="carta-indice-numeral">{apartado.numeral}</span>
                  <span class="carta-indice-nombre">{apartado.nombre}</span>
                  <span class="horario-puntos" aria-hidden="true" />
                  <span class="carta-indice-total">{apartado.total}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </header>

  <div class="sticky top-0 z-30 border-y border-tinta/10 bg-marfil/95 backdrop-blur-md md:top-[5.25rem]">
    <div class="mx-auto max-w-[1400px] px-5 md:px-6 lg:px-10">
      <search class="block pt-3">
        <label for="buscar-platillo" class="sr-only">Buscar un platillo</label>
        <div class="buscador relative flex items-center">
          <Icono nombre="buscar" class="pointer-events-none absolute left-4 h-[1.1rem] w-[1.1rem] text-olivo-claro" />
          <input
            id="buscar-platillo"
            type="search"
            autocomplete="off"
            enterkeyhint="search"
            placeholder=""
            data-sugerencias={JSON.stringify(sugerencias)}
            aria-describedby="buscar-estado"
            class="h-11 w-full rounded-full border border-tinta/12 bg-white/70 pl-11 pr-4 text-[0.95rem] text-tinta placeholder:text-tinta/45 focus:border-olivo-claro focus:bg-white focus:outline-none md:max-w-md"
          />
        </div>
        <p id="buscar-estado" aria-live="polite" class="sr-only"></p>
      </search>
      <nav aria-label="Categorías del menú">
        <ul
          class="sin-barra flex snap-x gap-2 overflow-x-auto py-3 md:flex-wrap md:gap-x-2 md:gap-y-2 md:overflow-visible"
        >
          {
            chips.map((chip) => (
              <li class="snap-start" data-chip={chip.href.slice(1)}>
                <a
                  href={chip.href}
                  class="inline-block whitespace-nowrap rounded-full border border-tinta/15 px-4 py-1.5 text-[0.8rem] font-medium text-tinta/75 transition-colors hover:border-olivo-claro hover:bg-olivo-claro hover:text-marfil"
                >
                  {chip.etiqueta}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div>
    <div class="mx-auto max-w-[1400px] px-5 pb-4 md:px-6 lg:px-10">
      <div id="sin-resultados" hidden class="py-20 text-center">
        <p class="font-display text-3xl text-olivo">No encontramos ese platillo.</p>
        <p class="mt-3 text-sm text-tinta/65">
          Prueba con otra palabra o
          <a href={whatsappCarta} target="_blank" rel="noopener noreferrer" class="enlace font-semibold text-olivo-claro">pregúntanos por WhatsApp</a>.
        </p>
      </div>
      <section aria-labelledby="grupo-chef" data-grupo class="pt-14">
        <div class="max-w-[62ch]">
          <h2 id="grupo-chef" class="scroll-mt-40 md:scroll-mt-64 text-2xl text-olivo sm:text-3xl">Sugerencias del chef</h2>
          <p class="mt-2 text-sm leading-relaxed text-tinta/70">
            Entradas, cremas y sopas, ensaladas, pastas, aves, pescados y mariscos, carnes y
            postres.
          </p>
        </div>
        <div class="mt-8">
          {
            secciones
              .filter((seccion) => seccion.grupo === 'Sugerencias del chef')
              .map((seccion) => <MenuCategoria {...seccion} />)
          }
        </div>
      </section>

      <section aria-labelledby="grupo-desayunos" data-grupo class="pt-16">
        <div class="max-w-[62ch]">
          <h2 id="grupo-desayunos" class="scroll-mt-40 md:scroll-mt-64 text-2xl text-olivo sm:text-3xl">Desayunos</h2>
          <p class="mt-2 text-sm leading-relaxed text-tinta/70">
            Dulces y frescos, tostados y omelette, huevos y antojitos, chilaquiles y moles, y
            extras para acompañar.
          </p>
        </div>
        <div class="mt-8">
          {
            secciones
              .filter((seccion) => seccion.grupo === 'Desayunos')
              .map((seccion) => <MenuCategoria {...seccion} />)
          }
        </div>
      </section>

      <section aria-labelledby="grupo-bebidas" data-grupo class="pt-16">
        <div class="max-w-[62ch]">
          <h2 id="grupo-bebidas" class="scroll-mt-40 md:scroll-mt-64 text-2xl text-olivo sm:text-3xl">Bebidas</h2>
          <p class="mt-2 text-sm leading-relaxed text-tinta/70">
            Jugos naturales en dos tamaños y bebidas calientes para cerrar la comida.
          </p>
        </div>
        <div class="mt-8">
          {
            secciones
              .filter((seccion) => seccion.grupo === 'Bebidas')
              .map((seccion) => <MenuCategoria {...seccion} />)
          }
        </div>
      </section>
    </div>
  </div>

  <section class="mt-16 bg-olivo-noche py-24 text-marfil md:py-32" aria-labelledby="titulo-cierre-menu">
    <div class="mx-auto flex max-w-[1400px] flex-col gap-10 px-5 md:flex-row md:items-end md:justify-between md:px-6 lg:px-10">
      <div>
        <h2 id="titulo-cierre-menu" class="display-lg">
          ¿Dudas sobre <em class="italic text-oro">la carta?</em>
        </h2>
        <p class="mt-6 max-w-[40ch] text-marfil/70">
          Escríbenos y con gusto te ayudamos con tus pedidos y reservaciones.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href={whatsappCarta} target="_blank" rel="noopener noreferrer" class="boton group bg-marfil text-olivo-noche hover:bg-oro">
          Escribir por WhatsApp
          <span class="boton-icono bg-olivo-noche/10">
            <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </span>
        </a>
        <a href="/" class="enlace pb-1 text-[0.95rem] font-semibold">Volver al inicio</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const entrada = document.getElementById('buscar-platillo') as HTMLInputElement | null;
  const estado = document.getElementById('buscar-estado');
  const vacio = document.getElementById('sin-resultados');

  if (entrada) {
    const normalizar = (texto: string) =>
      texto.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();

    const categorias = [...document.querySelectorAll<HTMLElement>('[data-categoria]')];
    const grupos = [...document.querySelectorAll<HTMLElement>('[data-grupo]')];
    const platos = categorias.map((categoria) =>
      [...categoria.querySelectorAll<HTMLElement>('[data-plato]')].map((plato) => ({
        el: plato,
        texto: normalizar(plato.dataset.plato ?? ''),
      })),
    );

    /* ---- Filtro ---- */
    const filtrar = () => {
      const terminos = normalizar(entrada.value).split(/\s+/).filter(Boolean);
      let total = 0;
      categorias.forEach((categoria, i) => {
        let visibles = 0;
        platos[i].forEach(({ el, texto }) => {
          const coincide = terminos.every((t) => texto.includes(t));
          el.hidden = !coincide;
          if (coincide) visibles++;
        });
        categoria.hidden = visibles === 0;
        document
          .querySelector<HTMLElement>(`[data-chip="${categoria.id}"]`)
          ?.toggleAttribute('hidden', visibles === 0);
        total += visibles;
      });
      grupos.forEach((grupo) => {
        grupo.hidden = !grupo.querySelector('[data-categoria]:not([hidden])');
      });
      if (vacio) vacio.hidden = total > 0;

      // Si la barra ya está fija, lleva la vista al inicio de los resultados.
      const barra = entrada.closest<HTMLElement>('.sticky');
      const contenido = barra?.nextElementSibling as HTMLElement | null;
      if (barra && contenido) {
        const destino =
          contenido.getBoundingClientRect().top + window.scrollY - barra.offsetHeight - parseFloat(getComputedStyle(barra).top);
        if (window.scrollY > destino) window.scrollTo({ top: destino });
      }
      if (estado) {
        estado.textContent = terminos.length
          ? total === 0
            ? 'Sin resultados'
            : `${total} ${total === 1 ? 'platillo' : 'platillos'}`
          : '';
      }
    };

    let espera = 0;
    entrada.addEventListener('input', () => {
      clearTimeout(espera);
      espera = window.setTimeout(filtrar, 120);
    });
    entrada.addEventListener('keydown', (evento) => {
      if (evento.key === 'Enter') entrada.blur();
    });

    // Al buscar, la lista se lleva al inicio de los resultados.
    entrada.addEventListener('focus', () => {
      const barra = entrada.closest<HTMLElement>('.sticky');
      if (barra && barra.getBoundingClientRect().top > 100) {
        window.scrollTo({ top: window.scrollY + barra.getBoundingClientRect().top, behavior: 'smooth' });
      }
    });

    /* ---- Máquina de escribir en el placeholder ---- */
    const sugerencias: string[] = JSON.parse(entrada.dataset.sugerencias ?? '[]');
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (quieto && sugerencias.length) entrada.placeholder = sugerencias[0];

    if (!quieto && sugerencias.length) {
      const lista = [...sugerencias].sort(() => Math.random() - 0.5);
      let indice = 0;
      let letras = 0;
      let borrando = false;

      const pausado = () => document.activeElement === entrada || entrada.value !== '' || document.hidden;

      const paso = () => {
        if (pausado()) {
          entrada.placeholder = '';
          window.setTimeout(paso, 600);
          return;
        }
        const palabra = lista[indice];
        letras += borrando ? -1 : 1;
        entrada.placeholder = palabra.slice(0, letras);

        let demora = borrando ? 28 : 60 + Math.random() * 50;
        if (!borrando && letras === palabra.length) {
          borrando = true;
          demora = 1700;
        } else if (borrando && letras === 0) {
          borrando = false;
          indice = (indice + 1) % lista.length;
          demora = 350;
        }
        window.setTimeout(paso, demora);
      };
      window.setTimeout(paso, 900);
    }
  }
</script>
